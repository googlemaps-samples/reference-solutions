# Google Maps Platform API Key (REQUIRED)
# Keep this secret out of version control. Copy this file to .env and replace the placeholder below.
#
# Quickstart — Obtain a free zero-billing Maps Demo Key for prototyping:
#   1. Open https://mapsplatform.google.com/maps-demo-key?utm_campaign=gmp_git_agentsamples_v1.0.0
#   2. Sign in with any Google account (no billing card or Cloud project required).
#   3. Accept the Maps Demo Project Terms when prompted.
#   4. Generate/reveal the demo key and paste it below.
#
# For production, create and restrict a key in Google Cloud Console:
#   https://console.cloud.google.com/google/maps-apis/credentials?utm_campaign=gmp_git_agentsamples_v1.0.0
# Enable: Maps JavaScript API, Map Tiles API, Places API (New), Elevation API.
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Optional local server port (default: 3000). Server always binds to 127.0.0.1.
PORT=3000
