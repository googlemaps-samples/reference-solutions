# Google Maps Platform API Key
# Copy this file to `.env` and replace the placeholder below with your key.
#
# Quickest Prototyping Option — Free Zero-Billing Maps Demo Key:
# 1. Open https://mapsplatform.google.com/maps-demo-key?utm_campaign=gmp_git_agentsamples_v1.0.0
# 2. Sign in with any Google account (no billing card or Cloud project required).
# 3. Accept the Maps Demo Project Terms and click to generate/reveal your Demo Key.
# 4. Paste the key below in `.env` (never commit `.env` to source control).
#
# Note: The Maps Demo Key is for prototyping only (subject to daily reset limits).
# For production, create and restrict an API key in Google Cloud Console:
# https://console.cloud.google.com/google/maps-apis/credentials?utm_campaign=gmp_git_agentsamples_v1.0.0
# Enable: Maps JavaScript API, Map Tiles API, Places API (New), and Elevation API.
# Restrict by HTTP referrer and designated APIs:
# https://developers.google.com/maps/api-security-best-practices?utm_campaign=gmp_git_agentsamples_v1.0.0

GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
