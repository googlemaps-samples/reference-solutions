# Google Maps Platform API key for Vite client runtime
# Obtain a free, zero-billing Maps Demo Key for prototyping:
# https://mapsplatform.google.com/maps-demo-key?utm_campaign=gmp_git_agentsamples_v1.0.0
#
# Copy this file to `.env.local` and replace the placeholder with your key:
#   cp .env.example .env.local
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
