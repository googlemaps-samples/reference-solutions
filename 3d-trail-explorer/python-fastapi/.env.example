# Google Maps Platform API Key
# Never commit your real .env file to version control.
#
# Quickstart (Free Prototyping - No Billing Required):
# 1. Visit https://mapsplatform.google.com/maps-demo-key?utm_campaign=gmp_git_agentsamples_v1.0.0
# 2. Sign in with a Google account (no billing card required)
# 3. Accept the Maps Demo Project Terms when prompted
# 4. Generate/reveal your Demo Key and paste it below
#
# Production Setup:
# Create and restrict a key in Google Cloud Console:
# https://console.cloud.google.com/google/maps-apis/credentials?utm_campaign=gmp_git_agentsamples_v1.0.0
# Enable: Maps JavaScript API, Places API (New), Elevation API, Map Tiles API
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
