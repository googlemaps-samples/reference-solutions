# Google Maps Platform API Key for Vite client-side Maps JavaScript API
#
# Quickstart (Free, No Billing Required for Prototyping):
# 1. Open https://mapsplatform.google.com/maps-demo-key?utm_campaign=gmp_git_agentsamples_v1.0.0
# 2. Sign in with any Google account and accept the Maps Demo Project Terms.
# 3. Generate and reveal your Maps Demo Key.
# 4. Copy this file to `.env.local` and replace the placeholder below with your key:
#      cp .env.example .env.local
#
# Note: The Maps Demo Key is for prototyping only (subject to daily quota limits).
# For production, create and HTTP-referrer-restrict a key in Google Cloud Console
# with Maps JavaScript API, Places API (New), Routes API, and Geocoding API enabled:
# https://console.cloud.google.com/google/maps-apis/credentials?utm_campaign=gmp_git_agentsamples_v1.0.0

VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
