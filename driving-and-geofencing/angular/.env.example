# Google Maps Platform API Key
# Leave blank here; copy this file to .env and set your key locally.
#
# Option 1 (Fastest - No Billing / No Cloud Project Required for Prototyping):
# Obtain a free Maps Demo Key:
#   1. Open https://mapsplatform.google.com/maps-demo-key?utm_campaign=gmp_git_agentsamples_v1.0.0
#   2. Sign in with any Google account (no billing card required)
#   3. Accept the Maps Demo Project Terms when prompted
#   4. Click to generate / reveal your Maps Demo Key
#   5. Copy the key and paste it below into your .env file
# Note: The Maps Demo Key has a daily reset limit and is for prototyping only (not production).
#
# Option 2 (Production - Google Cloud Console):
# Create a restricted API key in https://console.cloud.google.com/google/maps-apis/credentials?utm_campaign=gmp_git_agentsamples_v1.0.0
# Enable: Maps JavaScript API, Places API (New), Routes API, Geocoding API
# Restrict by HTTP Referrer and API restrictions:
#   https://docs.cloud.google.com/api-keys/docs/add-restrictions-api-keys?utm_campaign=gmp_git_agentsamples_v1.0.0

GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
