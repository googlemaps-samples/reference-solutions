# Google Maps Platform API Key
# Copy this file to .env.local and replace with your own key.
#
# Quickstart (Zero-Billing Maps Demo Key for Prototyping):
#   1. Open https://mapsplatform.google.com/maps-demo-key?utm_campaign=gmp_git_agentsamples_v1.0.0
#   2. Sign in with any Google account (no billing card required)
#   3. Accept the Maps Demo Project Terms when prompted
#   4. Click Generate / Reveal Demo Key and copy the key below
#
# Required APIs for Production Google Cloud Projects:
#   - Maps JavaScript API
#   - Places API (New)
#   - Routes API
#   - Geocoding API
#
# Security: Restrict production keys in Google Cloud Console:
#   https://console.cloud.google.com/google/maps-apis/credentials?utm_campaign=gmp_git_agentsamples_v1.0.0
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Optional server-only key for Next.js Route Handlers (/api/*).
# If omitted, server routes fall back to NEXT_PUBLIC_GOOGLE_MAPS_API_KEY.
# GOOGLE_MAPS_API_KEY=your_server_side_google_maps_api_key_here
