# Google Maps Platform API Key
# Never commit your real API key or .env file to version control.
#
# Quickstart (Zero-Billing Prototyping):
# 1. Open https://mapsplatform.google.com/maps-demo-key?utm_campaign=gmp_git_agentsamples_v1.0.0
# 2. Sign in with a Google account (no billing card required)
# 3. Accept the Maps Demo Project Terms
# 4. Generate and copy your demo key
# 5. Copy this file to .env and paste your key below
#
# Production Setup:
# - Create a restricted API key in Google Cloud Console:
#   https://console.cloud.google.com/google/maps-apis/credentials?utm_campaign=gmp_git_agentsamples_v1.0.0
# - Enable: Maps JavaScript API, Places API (New), Routes API, Elevation API
# - Restrict by HTTP referrer and enabled APIs:
#   https://docs.cloud.google.com/api-keys/docs/add-restrictions-api-keys?utm_campaign=gmp_git_agentsamples_v1.0.0

GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
