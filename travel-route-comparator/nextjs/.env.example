# Google Maps Platform API Key (used by the browser Maps JavaScript API & Places UI)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Optional server-side API key for Next.js Route Handlers (falls back to NEXT_PUBLIC_GOOGLE_MAPS_API_KEY if unset)
# GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# ---------------------------------------------------------------------------
# How to obtain a free, zero-billing Maps Demo Key for prototyping:
# 1. Visit https://mapsplatform.google.com/maps-demo-key?utm_campaign=gmp_git_agentsamples_v1.0.0
# 2. Sign in with a Google account (no billing card or Cloud project required).
# 3. Accept the Maps Demo Project Terms when prompted.
# 4. Generate/reveal your Demo Key and copy it into .env.local as:
#    NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_copied_key
#
# Note: The Maps Demo Key has a daily usage limit and is for prototyping only.
# For production, create and restrict a Cloud API key at:
# https://console.cloud.google.com/google/maps-apis/credentials?utm_campaign=gmp_git_agentsamples_v1.0.0
# Required APIs: Maps JavaScript API, Places API (New), Routes API, Elevation API
# ---------------------------------------------------------------------------
