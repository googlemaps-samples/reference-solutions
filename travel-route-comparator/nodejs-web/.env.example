# Google Maps Platform API Key (NEVER commit your real .env file)
#
# Quickstart (Free Zero-Billing Maps Demo Key for Prototyping):
# 1. Open https://mapsplatform.google.com/maps-demo-key?utm_campaign=gmp_git_agentsamples_v1.0.0
# 2. Sign in with your Google account (no billing account or Cloud project needed).
# 3. Accept the Maps Demo Project Terms when prompted.
# 4. Generate and copy your Maps Demo Key.
# 5. Copy this file to .env and paste the key below.
#
# For Production:
# Create a restricted API key in Google Cloud Console:
# https://console.cloud.google.com/google/maps-apis/credentials?utm_campaign=gmp_git_agentsamples_v1.0.0
# Enable: Maps JavaScript API, Places API (New), Routes API, Elevation API.
# Note: The Elevation API may require a standard Cloud project key if not covered by the Demo Key.
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
PORT=3000
