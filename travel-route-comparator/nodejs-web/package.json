{
  "name": "travel-route-comparator-nodejs-web",
  "version": "1.0.0",
  "private": true,
  "description": "Multi-Modal Commute Comparator & Trail Elevation Tracker using Node.js, Express, TypeScript, and Google Maps Platform APIs",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node dist/server.js --host 127.0.0.1 --port 3000",
    "dev": "tsc && node dist/server.js --host 127.0.0.1 --port 3000"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  }
}
