# Google Maps Platform API Key (REQUIRED)
# ------------------------------------------------------------------------------
# Option A (Prototyping / Zero-Billing): Obtain a free Maps Demo Key:
#   1. Open https://mapsplatform.google.com/maps-demo-key?utm_campaign=gmp_git_agentsamples_v1.0.0
#   2. Sign in with any Google account (no billing card required)
#   3. Accept the Maps Demo Project Terms when prompted
#   4. Generate and copy the Demo Key
#   5. Paste it below (never commit .env to version control)
#
# Option B (Production): Create and restrict an API key in Google Cloud Console:
#   https://console.cloud.google.com/google/maps-apis/credentials?utm_campaign=gmp_git_agentsamples_v1.0.0
#   Enable: Maps JavaScript API, Places API (New), Routes API
#   Restrict key: https://docs.cloud.google.com/api-keys/docs/add-restrictions-api-keys?utm_campaign=gmp_git_agentsamples_v1.0.0

GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
PORT=3000
