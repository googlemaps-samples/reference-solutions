{
  "name": "neighborhood-discovery-nextjs",
  "version": "1.0.0",
  "private": true,
  "description": "Hyperlocal Neighborhood Directory & Spot Mapper built with Next.js App Router, TypeScript, @vis.gl/react-google-maps, Places API (New), and Geocoding API.",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3000",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3000",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@vis.gl/react-google-maps": "^1.10.2",
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/google.maps": "^3.66.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "typescript": "^5.8.3"
  }
}
