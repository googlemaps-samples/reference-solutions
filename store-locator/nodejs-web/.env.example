# Google Maps Platform API Key
# Never commit your real .env file to version control.
#
# Option 1 (Fast Prototyping, No Billing Required):
#   Obtain a free Maps Demo Key:
#   https://mapsplatform.google.com/maps-demo-key?utm_campaign=gmp_git_agentsamples_v1.0.0
#   Steps:
#   1. Open the link above and sign in with a Google account.
#   2. Accept the Maps Demo Project Terms when prompted.
#   3. Click to generate/reveal your demo key and copy it below.
#   Note: The Maps Demo Key has a daily reset quota and is not for production.
#
# Option 2 (Production):
#   Create an API key in Google Cloud Console:
#   https://console.cloud.google.com/google/maps-apis/credentials?utm_campaign=gmp_git_agentsamples_v1.0.0
#   Enable: Maps JavaScript API, Places API (New), Routes API, Geocoding API.
#   Restrict the key to your referrers/IPs and designated APIs:
#   https://docs.cloud.google.com/api-keys/docs/add-restrictions-api-keys?utm_campaign=gmp_git_agentsamples_v1.0.0

GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
PORT=3000
