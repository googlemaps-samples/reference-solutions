{
  "name": "store-locator-sveltekit",
  "version": "1.0.0",
  "private": true,
  "description": "Multi-Branch Store, ATM & Inventory Locator built with SvelteKit, TypeScript, @googlemaps/js-api-loader, AdvancedMarkerElement, MarkerClusterer, Places API (New), and Routes API.",
  "scripts": {
    "dev": "vite dev --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch"
  },
  "dependencies": {
    "@googlemaps/js-api-loader": "^2.0.0",
    "@googlemaps/markerclusterer": "^2.6.2"
  },
  "devDependencies": {
    "@sveltejs/adapter-auto": "^4.0.0",
    "@sveltejs/kit": "^2.17.1",
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@types/google.maps": "^3.58.1",
    "svelte": "^5.20.2",
    "svelte-check": "^4.1.4",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  },
  "type": "module"
}
