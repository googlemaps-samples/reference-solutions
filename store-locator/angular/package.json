{
  "name": "store-locator-angular",
  "version": "1.0.0",
  "private": true,
  "description": "Multi-Branch Store, ATM & Inventory Locator built with Angular Standalone Components, @angular/google-maps, Places API (New), Routes API, and MarkerClusterer.",
  "scripts": {
    "ng": "ng",
    "start": "node serve-dist.mjs --host 127.0.0.1 --port 4200",
    "build": "ng build",
    "dev": "ng serve --host 127.0.0.1 --port 4200",
    "typecheck": "tsc --noEmit && node --check serve-dist.mjs"
  },
  "dependencies": {
    "@angular/common": "^22.3.0",
    "@angular/compiler": "^22.3.0",
    "@angular/core": "^22.3.0",
    "@angular/forms": "^22.3.0",
    "@angular/google-maps": "^22.3.0",
    "@angular/platform-browser": "^22.3.0",
    "@googlemaps/js-api-loader": "^2.1.3",
    "@googlemaps/markerclusterer": "^2.6.2",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "~0.16.0"
  },
  "devDependencies": {
    "@angular/build": "^22.3.0",
    "@angular/cli": "^22.3.0",
    "@angular/compiler-cli": "^22.3.0",
    "@types/google.maps": "^3.66.10",
    "@types/node": "^22.15.3",
    "typescript": "~6.0.3"
  }
}
