{
  "name": "itinerary-planner-angular",
  "version": "1.0.0",
  "private": true,
  "description": "Multi-Day Trip Itinerary Planner, Hotels & Time Zone Hub built with Angular Standalone Components, @angular/google-maps, Places API (New), Routes API, Time Zone API, and Street View.",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --host 127.0.0.1 --port 4200",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "serve:dist": "node serve-dist.mjs --host 127.0.0.1 --port 4173",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@angular/common": "^22.3.0",
    "@angular/compiler": "^22.3.0",
    "@angular/core": "^22.3.0",
    "@angular/forms": "^22.3.0",
    "@angular/google-maps": "^22.3.0",
    "@angular/platform-browser": "^22.3.0",
    "@googlemaps/js-api-loader": "^2.1.3",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "~0.16.0"
  },
  "devDependencies": {
    "@angular/build": "^22.3.0",
    "@angular/cli": "^22.3.0",
    "@angular/compiler-cli": "^22.3.0",
    "@types/google.maps": "^3.66.10",
    "@types/node": "^22.15.0",
    "typescript": "~6.0.2"
  }
}
