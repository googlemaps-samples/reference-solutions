# Google Maps Platform API Key (never commit a real .env file)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Optional server port (default: 3000; always binds to 127.0.0.1)
PORT=3000

# ---------------------------------------------------------------------------
# Quickstart: Free Zero-Billing Maps Demo Key (Prototyping Only)
# ---------------------------------------------------------------------------
# 1. Open: https://mapsplatform.google.com/maps-demo-key?utm_campaign=gmp_git_agentsamples_v1.0.0
# 2. Sign in with any Google account (no billing card required).
# 3. Accept the Maps Demo Project Terms when prompted.
# 4. Click "Create API Key" / reveal your demo key.
# 5. Copy .env.example to .env and paste the key into GOOGLE_MAPS_API_KEY=...
#
# Note: The Maps Demo Key supports Maps JavaScript API, Places API (New), and
# Routes API with a daily quota limit. For Roads API (Snap to Roads) and
# production workloads, create a restricted key in Google Cloud Console:
# https://console.cloud.google.com/google/maps-apis/credentials?utm_campaign=gmp_git_agentsamples_v1.0.0
