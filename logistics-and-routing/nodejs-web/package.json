{
  "name": "logistics-and-routing-nodejs-web",
  "version": "1.0.0",
  "description": "Fleet Telematics, Road-Snapped GPS & Multi-Stop Dispatch Dashboard powered by Node.js, Express, TypeScript, and modern Google Maps Platform APIs.",
