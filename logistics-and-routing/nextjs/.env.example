# Google Maps Platform API Key (Required for Maps JavaScript API in browser & BFF fallback)
# Never hardcode real keys in source control. Copy this file to .env.local.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Optional dedicated server-side key for Next.js BFF Route Handlers (/api/routes/*, /api/roads/*, /api/places/*)
# If omitted, server routes fall back to NEXT_PUBLIC_GOOGLE_MAPS_API_KEY.
# GOOGLE_MAPS_API_KEY=your_server_side_google_maps_api_key_here

# ==============================================================================
# How to obtain a free zero-billing Maps Demo Key for prototyping:
# 1. Open https://mapsplatform.google.com/maps-demo-key?utm_campaign=gmp_git_agentsamples_v1.0.0
# 2. Sign in with any Google account (no billing card or Cloud project required).
# 3. Accept the Maps Demo Project Terms when prompted.
# 4. Generate/reveal your Demo Key and paste it into .env.local as NEXT_PUBLIC_GOOGLE_MAPS_API_KEY.
# Note: The Maps Demo Key has daily quota limits and is for prototyping only.
# For production (including Roads API Snap to Roads), create a restricted key in Google Cloud Console:
# https://console.cloud.google.com/google/maps-apis/credentials?utm_campaign=gmp_git_agentsamples_v1.0.0
# ==============================================================================
