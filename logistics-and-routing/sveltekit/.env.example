# Google Maps Platform API Key (SvelteKit public runtime env var)
# Copy this file to .env and paste your key below. NEVER commit .env to git.
#
# Quickstart — Free Zero-Billing Maps Demo Key (Prototyping Only):
# 1. Open https://mapsplatform.google.com/maps-demo-key?utm_campaign=gmp_git_agentsamples_v1.0.0
# 2. Sign in with any Google account (no billing card required)
# 3. Accept the Maps Demo Project Terms when prompted
# 4. Generate/reveal your Demo Key and copy it below
#
# Note: For full production usage (and Roads API snapToRoads), create and restrict
# an API key in Google Cloud Console:
# https://console.cloud.google.com/google/maps-apis/credentials?utm_campaign=gmp_git_agentsamples_v1.0.0
# Enable: Maps JavaScript API, Places API (New), Routes API, and Roads API.
PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
