# Google Maps Platform API Key (NEVER hardcode real keys in source files or commit .env)
#
# Quickstart for Prototyping (Zero Billing / No Cloud Project Required):
# 1. Open https://mapsplatform.google.com/maps-demo-key?utm_campaign=gmp_git_agentsamples_v1.0.0
# 2. Sign in with any Google account (no billing card required) and accept the Demo Project Terms.
# 3. Click to generate/reveal your free Maps Demo Key.
# 4. Copy this file to `.env` and paste your key below.
#
# For Production:
# Create a restricted key in Google Cloud Console:
# https://console.cloud.google.com/google/maps-apis/credentials?utm_campaign=gmp_git_agentsamples_v1.0.0
# Enable: Maps JavaScript API, Places API (New), Routes API, and Roads API.
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Optional Cloud-based Vector Map ID (defaults to DEMO_MAP_ID for AdvancedMarkerElement)
GOOGLE_MAPS_MAP_ID=DEMO_MAP_ID
