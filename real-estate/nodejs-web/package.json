{
  "name": "gmp-real-estate-nodejs-web",
  "version": "1.0.0",
  "private": true,
  "description": "Split-Screen Real Estate Search, Parcel Polygon & Commute Explorer built with Node.js, Express, TypeScript, and Google Maps Platform.",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node dist/server.js --host 127.0.0.1 --port 3000"
  },
  "dependencies": {
    "@googlemaps/js-api-loader": "^2.1.3",
    "@googlemaps/markerclusterer": "^2.6.2",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "terra-draw": "^1.40.0",
    "terra-draw-google-maps-adapter": "^1.7.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/google.maps": "^3.67.0",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.3"
  }
}
