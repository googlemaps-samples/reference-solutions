{
  "name": "real-estate-angular",
  "version": "1.0.0",
  "private": true,
  "description": "Split-Screen Real Estate Search, Parcel Polygon & Commute Explorer in Angular Standalone Components + Google Maps Platform",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --host 127.0.0.1 --port 4200",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "typecheck": "tsc --noEmit",
    "serve:dist": "node serve-dist.mjs --host 127.0.0.1 --port 4200"
  },
  "dependencies": {
    "@angular/common": "^22.3.0",
    "@angular/compiler": "^22.3.0",
    "@angular/core": "^22.3.0",
    "@angular/forms": "^22.3.0",
    "@angular/google-maps": "^22.3.0",
    "@angular/platform-browser": "^22.3.0",
    "@googlemaps/js-api-loader": "^2.1.3",
    "@googlemaps/markerclusterer": "^2.6.2",
    "rxjs": "^7.8.2",
    "terra-draw": "^1.40.0",
    "terra-draw-google-maps-adapter": "^1.7.0",
    "tslib": "^2.9.1",
    "zone.js": "^0.16.3"
  },
  "devDependencies": {
    "@angular/build": "^22.3.0",
    "@angular/cli": "^22.3.0",
    "@angular/compiler-cli": "^22.3.0",
    "@types/google.maps": "^3.67.0",
    "typescript": "~6.0.3"
  }
}
