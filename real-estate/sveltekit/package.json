{
  "name": "gmp-real-estate-sveltekit",
  "version": "1.0.0",
  "private": true,
  "description": "Split-Screen Real Estate Search, Parcel Polygon & Commute Explorer in SvelteKit + TypeScript using Google Maps Platform modern APIs",
  "type": "module",
  "scripts": {
    "dev": "vite dev --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch"
  },
  "dependencies": {
    "@googlemaps/js-api-loader": "^2.1.3",
    "@googlemaps/markerclusterer": "^2.6.2",
    "terra-draw": "^1.40.0",
    "terra-draw-google-maps-adapter": "^1.7.0"
  },
  "devDependencies": {
    "@sveltejs/adapter-auto": "^7.0.1",
    "@sveltejs/kit": "^2.70.4",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@types/google.maps": "^3.67.0",
    "svelte": "^5.58.0",
    "svelte-check": "^4.7.8",
    "typescript": "^5.9.3",
    "vite": "^7.3.1"
  }
}
