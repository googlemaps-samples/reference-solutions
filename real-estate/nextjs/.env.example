# Google Maps Platform API Key (Client + Server BFF Route Handlers)
# Copy this file to .env.local and paste your key below.
#
# Quickstart: Free Zero-Billing Maps Demo Key (Prototyping Only)
# 1. Open https://mapsplatform.google.com/maps-demo-key?utm_campaign=gmp_git_agentsamples_v1.0.0
# 2. Sign in with any Google account (no billing card or Cloud project required).
# 3. Accept the Maps Demo Project Terms when prompted.
# 4. Click to generate / reveal your demo key.
# 5. Copy the key and set NEXT_PUBLIC_GOOGLE_MAPS_API_KEY in .env.local.
#
# Production Setup:
# - Create and restrict your production key in Google Cloud Console:
#   https://console.cloud.google.com/google/maps-apis/credentials?utm_campaign=gmp_git_agentsamples_v1.0.0
# - Enable: Maps JavaScript API, Places API (New), Routes API, Geocoding API, Street View.
# - Security best practices:
#   https://developers.google.com/maps/api-security-best-practices?utm_campaign=gmp_git_agentsamples_v1.0.0

NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Optional: Server-only API key for Next.js Route Handlers (/api/places/*, /api/routes/*).
# If omitted, Route Handlers automatically fall back to NEXT_PUBLIC_GOOGLE_MAPS_API_KEY.
# GOOGLE_MAPS_API_KEY=your_server_restricted_api_key_here
