# Google Maps Platform API Key (NEVER commit real keys to version control)
#
# Option 1: Free Maps Demo Key (Prototyping only — no billing or Cloud project required):
#   1. Open https://mapsplatform.google.com/maps-demo-key?utm_campaign=gmp_git_agentsamples_v1.0.0
#   2. Sign in with any Google account and accept the Maps Demo Project Terms.
#   3. Click to generate/reveal your Maps Demo Key.
#   4. Copy and paste it below.
#
# Option 2: Production Google Cloud API Key:
#   Create a key at https://console.cloud.google.com/google/maps-apis/credentials?utm_campaign=gmp_git_agentsamples_v1.0.0
#   and enable: Maps JavaScript API, Places API (New), Address Validation API, Routes API, Maps Static API.
#   Restrict the key by HTTP referrer / server IP and API restrictions before deploying.
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Optional local server port (defaults to 3000; always binds strictly to 127.0.0.1)
PORT=3000
