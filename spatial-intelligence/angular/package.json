{
  "name": "nyc-spatial-intelligence-angular",
  "version": "1.0.0",
  "private": true,
  "description": "Enterprise GIS Workbench with GeoJSON Zones, Deck.gl Analytics, Terra Draw, Elevation API, and Places API (New) in Angular",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --host 127.0.0.1 --port 4200",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "typecheck": "tsc --noEmit",
    "serve:dist": "node serve-dist.mjs --host 127.0.0.1 --port 4200"
  },
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/google-maps": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@deck.gl/aggregation-layers": "^9.4.1",
    "@deck.gl/core": "^9.4.1",
    "@deck.gl/google-maps": "^9.4.1",
    "@deck.gl/layers": "^9.4.1",
    "@googlemaps/js-api-loader": "^2.1.3",
    "rxjs": "^7.8.1",
    "terra-draw": "^1.40.0",
    "terra-draw-google-maps-adapter": "^1.7.0",
    "tslib": "^2.8.1",
    "zone.js": "^0.16.3"
  },
  "devDependencies": {
    "@angular/build": "^21.2.30",
    "@angular/cli": "^21.2.30",
    "@angular/compiler-cli": "^21.2.26",
    "@types/google.maps": "^3.66.10",
    "typescript": "~5.9.3"
  }
}
