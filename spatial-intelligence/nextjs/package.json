{
  "name": "nyc-spatial-intelligence-workbench",
  "version": "1.0.0",
  "private": true,
  "description": "Enterprise Web GIS spatial analytics workbench centered on New York City with Google Maps JavaScript API, GeoJSON capacity zones, deck.gl GoogleMapsOverlay, Terra Draw polygon filtering, Elevation API terrain profiling, and Places API (New).",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@deck.gl/aggregation-layers": "^9.4.1",
    "@deck.gl/core": "^9.4.1",
    "@deck.gl/google-maps": "^9.4.1",
    "@deck.gl/layers": "^9.4.1",
    "@luma.gl/core": "^9.4.2",
    "@luma.gl/webgl": "^9.4.2",
    "@vis.gl/react-google-maps": "^1.10.2",
    "lucide-react": "^1.76.0",
    "next": "^16.4.6",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "terra-draw": "^1.40.0",
    "terra-draw-google-maps-adapter": "^1.7.0"
  },
  "devDependencies": {
    "@types/google.maps": "^3.58.1",
    "@types/node": "^22.10.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "typescript": "^5.7.3"
  }
}
