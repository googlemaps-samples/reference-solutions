# Google Maps Platform API Key (REQUIRED — do NOT commit real keys)
#
# Quickstart for Prototyping (Zero-Billing Maps Demo Key):
# 1. Visit https://mapsplatform.google.com/maps-demo-key?utm_campaign=gmp_git_agentsamples_v1.0.0
# 2. Sign in with any Google account (no billing card required)
# 3. Accept the Maps Demo Project Terms and copy your generated Demo Key
# 4. Paste it below and save this file as `.env`
#
# Note: For production deployments, create a dedicated Google Cloud project,
# enable Maps JavaScript API, Places API (New), and Elevation API, and restrict
# your key via https://docs.cloud.google.com/api-keys/docs/add-restrictions-api-keys?utm_campaign=gmp_git_agentsamples_v1.0.0
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Optional server port override (host is strictly bound to 127.0.0.1)
PORT=3000
