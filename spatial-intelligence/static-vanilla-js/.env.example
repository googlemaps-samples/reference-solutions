# Google Maps Platform API Key
# Copy this file to .env and replace with your API key:
#   cp .env.example .env
#
# Quickstart — Obtain a free, zero-billing Maps Demo Key for prototyping:
# 1. Open https://mapsplatform.google.com/maps-demo-key?utm_campaign=gmp_git_agentsamples_v1.0.0
# 2. Sign in with a Google account (no billing card required)
# 3. Accept the Maps Demo Project Terms when prompted
# 4. Click to generate / reveal your Demo Key
# 5. Paste the key below (note: Demo Keys have a daily reset limit and are not for production)
#
# Production keys:
# Create and restrict an API key in Google Cloud Console:
# https://console.cloud.google.com/google/maps-apis/credentials?utm_campaign=gmp_git_agentsamples_v1.0.0
# Enable: Maps JavaScript API, Places API (New), Elevation API.
# Restrict by HTTP referrer (for browser requests) and designated APIs.
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
