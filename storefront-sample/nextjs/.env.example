# Google Maps Platform API Key (Client Maps JS SDK + Server BFF Route Handlers)
# NEVER commit your real API key to version control.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Optional server-only override for Next.js Route Handlers (/api/places/*, /api/routes/*)
# When omitted, Route Handlers automatically fall back to NEXT_PUBLIC_GOOGLE_MAPS_API_KEY.
# GOOGLE_MAPS_API_KEY=your_server_google_maps_api_key_here

# ==============================================================================
# How to Obtain a Free, Zero-Billing Maps Demo Key (for Prototyping)
# ==============================================================================
# 1. Open: https://mapsplatform.google.com/maps-demo-key?utm_campaign=gmp_git_agentsamples_v1.0.0
# 2. Sign in with any personal Google account (no credit card or GCP billing required).
# 3. Accept the Maps Demo Project Terms when prompted.
# 4. Click to generate / reveal your Maps Demo Key.
# 5. Copy the key, create a `.env.local` file in this directory, and paste:
#      NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=<paste_your_key_here>
#
# Note: The Maps Demo Key has a daily reset limit and is NOT for production use.
# For production, create and restrict an API key in Google Cloud Console:
# https://console.cloud.google.com/google/maps-apis/credentials?utm_campaign=gmp_git_agentsamples_v1.0.0
# Required APIs: Maps JavaScript API, Places API (New), Routes API.
