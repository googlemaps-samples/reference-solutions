# Google Maps Platform API Key
# Copy this file to .env and provide your API key (NEVER commit .env to source control).
#
# Quick Prototyping Option (Zero Billing / No Cloud Project Setup Required):
# 1. Open https://mapsplatform.google.com/maps-demo-key?utm_campaign=gmp_git_agentsamples_v1.0.0
# 2. Sign in with any Google account (no billing card required)
# 3. Accept the Maps Demo Project Terms and generate/reveal your Maps Demo Key
# 4. Paste the key below in your local .env file
#
# Production Option:
# Create a restricted API key in Google Cloud Console:
# https://console.cloud.google.com/google/maps-apis/credentials?utm_campaign=gmp_git_agentsamples_v1.0.0
# Enable: Maps JavaScript API, Places API (New), Routes API, and Street View Static/JS API.

GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
