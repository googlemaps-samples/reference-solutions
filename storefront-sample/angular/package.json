{
  "name": "sf-dental-storefront-angular",
  "version": "1.0.0",
  "private": true,
  "description": "Single-Venue Storefront, Booking & Get Directions Hub built with Angular Standalone Components, @angular/google-maps, and Google Maps Platform (Places API New, Routes API, Street View, Advanced Markers).",
  "scripts": {
    "ng": "ng",
    "start": "npm run build && node serve-dist.mjs --host 127.0.0.1 --port 4200",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "typecheck": "tsc --noEmit && node --check serve-dist.mjs"
  },
  "dependencies": {
    "@angular/common": "^22.3.0",
    "@angular/compiler": "^22.3.0",
    "@angular/core": "^22.3.0",
    "@angular/forms": "^22.3.0",
    "@angular/google-maps": "^22.3.0",
    "@angular/platform-browser": "^22.3.0",
    "@googlemaps/js-api-loader": "^2.1.3",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "~0.16.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.8",
    "@angular/cli": "^22.2.8",
    "@angular/compiler-cli": "^22.3.0",
    "@types/google.maps": "^3.66.10",
    "typescript": "~6.0.2"
  }
}
