{
  "name": "storefront-sample-nodejs-web",
  "version": "1.0.0",
  "description": "Single-Venue Storefront, Booking & Get Directions Hub for a San Francisco multi-specialty dental clinic using Node.js, Express, TypeScript, and Google Maps Platform APIs.",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node dist/server.js",
    "dev": "tsc && node dist/server.js --host 127.0.0.1 --port 3000"
  },
  "keywords": [
    "google-maps-platform",
    "places-api-new",
    "routes-api",
    "street-view",
    "advanced-marker-element",
    "express",
    "typescript"
  ],
  "license": "Apache-2.0",
  "dependencies": {
    "dotenv": "^16.4.7",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
