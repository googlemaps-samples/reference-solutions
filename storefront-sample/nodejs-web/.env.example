# Google Maps Platform API Key (NEVER hardcode your key in source files)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Optional local server port (CLI --port takes precedence)
PORT=3000

# ==============================================================================
# How to obtain a free zero-billing Maps Demo Key for prototyping:
# 1. Open: https://mapsplatform.google.com/maps-demo-key?utm_campaign=gmp_git_agentsamples_v1.0.0
# 2. Sign in with any personal Google account (no billing card required).
# 3. Accept the Maps Demo Project Terms when prompted.
# 4. Click to generate/reveal your demo key (supports Maps JS, Places, Routes).
# 5. Copy the key above and save this file as .env
#
# Note: Maps Demo Keys have daily quota limits and are for prototyping only.
# For production, create and restrict a key in Google Cloud Console:
# https://console.cloud.google.com/google/maps-apis/credentials?utm_campaign=gmp_git_agentsamples_v1.0.0
# https://docs.cloud.google.com/api-keys/docs/add-restrictions-api-keys?utm_campaign=gmp_git_agentsamples_v1.0.0
# ==============================================================================
