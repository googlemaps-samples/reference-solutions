# ==============================================================================
# Google Maps Platform API Key Configuration
# ==============================================================================
#
# Option 1 (Fastest for Prototyping - Zero Billing Required):
#   Obtain a free, public Maps Demo Key at:
#   https://mapsplatform.google.com/maps-demo-key?utm_campaign=gmp_git_agentsamples_v1.0.0
#
#   Steps:
#   1. Visit the Maps Demo Key portal link above.
#   2. Copy the generated demo key.
#   3. Create `.env.local` in this directory and paste the key below.
#
# Option 2 (Production Google Cloud Project):
#   1. Create or select a Google Cloud project and enable billing.
#   2. Enable: Maps JavaScript API, Places API (New), Geocoding API,
#      Weather API, Air Quality API, Pollen API, and Solar API.
#   3. Create an HTTP-referrer-restricted key for NEXT_PUBLIC_GOOGLE_MAPS_API_KEY
#      and an IP-restricted server key for GOOGLE_MAPS_API_KEY (optional override
#      used by Next.js /api/* Route Handlers).
#
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Optional separate server-side key for Next.js Route Handlers (/api/*).
# When omitted, Route Handlers automatically fall back to NEXT_PUBLIC_GOOGLE_MAPS_API_KEY.
# GOOGLE_MAPS_API_KEY=your_server_google_maps_api_key_here
