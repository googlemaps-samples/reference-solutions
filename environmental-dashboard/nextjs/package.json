{
  "name": "environmental-dashboard-nextjs",
  "version": "1.0.0",
  "private": true,
  "description": "Hyperlocal Weather, Air Quality, Pollen & Solar Dashboard built with Next.js App Router, TypeScript, @vis.gl/react-google-maps, and Google Maps Platform environmental APIs.",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3000",
