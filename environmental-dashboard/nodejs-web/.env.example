# Google Maps Platform API Key (Required)
# Keep this secret out of source control and NEVER hardcode keys in source files.
#
# Quick Prototyping Option (Free, No Billing Required):
#   1. Visit https://mapsplatform.google.com/maps-demo-key?utm_campaign=gmp_git_agentsamples_v1.0.0
#   2. Sign in with any Google account and accept the Maps Demo Project Terms.
#   3. Generate and copy your Maps Demo Key.
#   4. Paste it below (note: Demo Key supports Maps JS API, Places API, Geocoding API,
#      Weather API, etc. with a daily quota; for Air Quality, Pollen, and Solar APIs in
#      production, use a standard Google Cloud API key with those APIs enabled).
#
# Production Option:
#   Create and restrict a key in Google Cloud Console:
#   https://console.cloud.google.com/google/maps-apis/credentials?utm_campaign=gmp_git_agentsamples_v1.0.0
#   Enable: Maps JavaScript API, Places API (New), Geocoding API, Weather API,
#   Air Quality API, Pollen API, Solar API.
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Optional local server port (defaults to 3000)
PORT=3000
