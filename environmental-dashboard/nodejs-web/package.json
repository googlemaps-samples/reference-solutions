{
  "name": "environmental-dashboard-nodejs-web",
  "version": "1.0.0",
  "description": "Hyperlocal Weather, Air Quality, Pollen & Solar Dashboard powered by Node.js, Express, TypeScript, and Google Maps Platform APIs.",
  "private": true,
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
