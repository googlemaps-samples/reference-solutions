{
  "name": "environmental-dashboard-angular",
  "version": "1.0.0",
  "private": true,
  "description": "Hyperlocal Weather, Air Quality, Pollen & Solar Dashboard built with Angular Standalone Components, @angular/google-maps, and Google Maps Platform APIs",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "typecheck": "npx tsc --noEmit && node --check serve-dist.mjs",
    "serve:dist": "node serve-dist.mjs --host 127.0.0.1 --port 4200"
  },
  "dependencies": {
    "@angular/common": "^19.2.0",
    "@angular/compiler": "^19.2.0",
    "@angular/core": "^19.2.0",
    "@angular/forms": "^19.2.0",
    "@angular/google-maps": "^19.2.0",
    "@angular/platform-browser": "^19.2.0",
    "@angular/platform-browser-dynamic": "^19.2.0",
    "@googlemaps/js-api-loader": "^2.1.3",
    "rxjs": "~7.8.1",
    "tslib": "^2.8.1",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^19.2.0",
    "@angular/cli": "^19.2.0",
    "@angular/compiler-cli": "^19.2.0",
    "@types/google.maps": "^3.58.1",
    "@types/node": "^22.10.0",
    "typescript": "~5.7.2"
  }
}
